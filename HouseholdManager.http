@baseUrl = http://localhost:5260
@adminUserName = {{$dotenv ADMIN_USER_NAME}}
@adminPassword = {{$dotenv ADMIN_PASSWORD}}
@childUserName = Child
@childPassword = Child12345678!
@token = {{login.response.body.$.token}}
@childToken = {{childLogin.response.body.$.token}}
@childId = {{createChild.response.body.$.id}}

# The admin login is read from the git-ignored file .env (copy .env.example to .env and fill it in). Never write the real values in this file.
# childUserName and childPassword are throwaway test values for the in-memory database.
# Run top to bottom against a freshly started app (the in-memory database is reset on every start).
# The seeded data is household 1 and the admin user. Ids in the comments assume a fresh start.
# Dates assume that today is 2026-11-10 (a Tuesday). Adjust the dates if you run it on another day.
# Enums are numbers. FrequencyType: Daily 0, Weekly 1, Monthly 2, Yearly 3.
# Weekdays are flags: Monday 1, Tuesday 2, Wednesday 4, Thursday 8, Friday 16, Saturday 32, Sunday 64.
# MeasurementUnit: Gram 0, Kilogram 1, Milliliter 2, Deciliter 3, Liter 4, Piece 5, Teaspoon 6, Tablespoon 7, Cup 8.

# Auth
### Without a token, should return 401

GET {{baseUrl}}/api/Chores

### Logs in as the admin, returns token and refreshToken
# @name login
POST {{baseUrl}}/api/Auth/login
Content-Type: application/json

{
  "userName": "{{adminUserName}}",
  "password": "{{adminPassword}}"
}

### Wrong password, should return 401

POST {{baseUrl}}/api/Auth/login
Content-Type: application/json

{
  "userName": "{{adminUserName}}",
  "password": "wrong"
}

### Creates the child account, returns the id of the child
# @name createChild
POST {{baseUrl}}/api/Users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userName": "{{childUserName}}",
  "password": "{{childPassword}}",
  "role": "child"
}

### The same user name again, should return 400

POST {{baseUrl}}/api/Users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userName": "{{childUserName}}",
  "password": "{{childPassword}}",
  "role": "child"
}

### Invalid role, should return 400

POST {{baseUrl}}/api/Users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userName": "Someone",
  "password": "Someone12345!",
  "role": "banana"
}

### Logs in as the child
# @name childLogin
POST {{baseUrl}}/api/Auth/login
Content-Type: application/json

{
  "userName": "{{childUserName}}",
  "password": "{{childPassword}}"
}

# Household
### Gets all households, should contain the seeded household 1

GET {{baseUrl}}/api/Households
Authorization: Bearer {{token}}

### Gets the household with id 1

GET {{baseUrl}}/api/Households/1
Authorization: Bearer {{token}}

### Gets the household with id 999, should return 404

GET {{baseUrl}}/api/Households/999
Authorization: Bearer {{token}}

### Adds a new household, gets id 2

POST {{baseUrl}}/api/Households
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Aa"
}

### Name with only one character, should return 400

POST {{baseUrl}}/api/Households
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "A"
}

### Updates household name for id 2

POST {{baseUrl}}/api/Households/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Changed household name"
}

### Update with no changes, should return 200

POST {{baseUrl}}/api/Households/2
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Deletes household 2

DELETE {{baseUrl}}/api/Households/2
Authorization: Bearer {{token}}

### Household 2 is gone, should return 404

GET {{baseUrl}}/api/Households/2
Authorization: Bearer {{token}}

