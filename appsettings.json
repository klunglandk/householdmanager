{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RecurrenceGeneration": {
    "HorizonDays": 28,
    "TimeZoneId": "Europe/Oslo",
    "DailyRunTime": "00:05:00"
  },
  "FileStorage": {
    "RootPath": "uploads",
    "MaxFileSizeBytes": 10485760
  },
  "Jwt": {
    "Issuer": "HouseholdManager",
    "Audience": "HouseholdManager",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 90
  }
}
